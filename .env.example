# Bring your own TypeSafe key for the Jev claim-verifier arm.
TYPESAFE_API_KEY=

# Optional overrides for the Jev arm.
# JEV_MODEL=jev-latest
# TYPESAFE_BASE=https://api.typesafe.ai
# TYPESAFE_ENDPOINT=/v1/systemone

# The hosted committed-state read. Leave unset to use the offline mock, which is
# what the rung-six matrix uses by default.
# FATHOM_READ_URL=
# FATHOM_READ_API_KEY=
